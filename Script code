local discoButton = makeButton(mainPanel, "DISCO MODE: OFF", 40)

local function stopDisco()
	if discoOriginal then
		Lighting.Ambient = discoOriginal.ambient
		Lighting.OutdoorAmbient = discoOriginal.outdoor

		local camera = workspace.CurrentCamera

		if camera then
			camera.FieldOfView = discoOriginal.fov
		end
	end

	for part, color in pairs(discoColors) do
		if part.Parent then
			part.Color = color
		end
	end

	discoColors = {}
	discoOriginal = nil
end

discoButton.Activated:Connect(function()
	DISCO_ENABLED = not DISCO_ENABLED

	discoButton.Text = "DISCO MODE: " .. (DISCO_ENABLED and "ON" or "OFF")

	if DISCO_ENABLED then
		local camera = workspace.CurrentCamera

		discoOriginal = {
			ambient = Lighting.Ambient,
			outdoor = Lighting.OutdoorAmbient,
			fov = camera and camera.FieldOfView or 70
		}
	else
		stopDisco()
	end
end)

RunService.RenderStepped:Connect(function()
	if not DISCO_ENABLED or not discoOriginal then
		return
	end

	local t = os.clock()
	local lightColor = Color3.fromHSV((t * 0.6) % 1, 1, 1)

	Lighting.Ambient = lightColor
	Lighting.OutdoorAmbient = lightColor

	local camera = workspace.CurrentCamera

	if camera then
		camera.FieldOfView = discoOriginal.fov + math.sin(t * 6) * 8
	end

	local character = player.Character

	if character then
		for index, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				if not discoColors[part] then
					discoColors[part] = part.Color
				end

				part.Color = Color3.fromHSV((t * 0.6 + index * 0.05) % 1, 1, 1)
			end
		end
	end
end)

