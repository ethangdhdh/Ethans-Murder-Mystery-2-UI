-- ROLE DETECTION
--==================================================

local function getRole(target)
	if not target then
		return nil
	end

	local attributes = {
		"Role",
		"PlayerRole",
		"RoleName",
		"TeamRole"
	}

	for _, attribute in ipairs(attributes) do
		local value = target:GetAttribute(attribute)

		if typeof(value) == "string" then
			return value
		end
	end

	local character = target.Character

	if character then
		for _, attribute in ipairs(attributes) do
			local value = character:GetAttribute(attribute)

			if typeof(value) == "string" then
				return value
			end
		end
	end

	if target.Team then
		return target.Team.Name
	end

	return nil
end

local function isSheriff(target)
	local role = getRole(target)

	if not role then
		return false
	end

	role = string.lower(role)

	return string.find(role, "sheriff") ~= nil
end

--==================================================
-- SHERIFF DEATH DETECTION
--==================================================

local function watchSheriff(target)

	local function watchCharacter(character)

		if sheriffConnections[target] then
			sheriffConnections[target]:Disconnect()
			sheriffConnections[target] = nil
		end

		local humanoid = character:WaitForChild("Humanoid", 5)
		local root = character:WaitForChild("HumanoidRootPart", 5)

		if not humanoid or not root then
			return
		end

		sheriffConnections[target] =
			humanoid.Died:Connect(function()

				if isSheriff(target) then
					sheriffDeathCFrame = root.CFrame

					sheriffStatus.Text =
						"SHERIFF DEATH: " .. target.Name
				end

			end)
	end

	if target.Character then
		task.spawn(function()
			watchCharacter(target.Character)
		end)
	end

	target.CharacterAdded:Connect(watchCharacter)
end

for _, target in ipairs(Players:GetPlayers()) do
	if target ~= player then
		watchSheriff(target)
	end
end

Players.PlayerAdded:Connect(function(target)
	if target ~= player then
		watchSheriff(target)
	end
end)

Players.PlayerRemoving:Connect(function(target)

	if sheriffConnections[target] then
		sheriffConnections[target]:Disconnect()
		sheriffConnections[target] = nil
	end

end)

