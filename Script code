-- Same checksum as the Key Vault page.
local function hashString(text)
	local h = 5381

	for i = 1, #text do
		h = (h * 33 + string.byte(text, i)) % 4294967296
	end

	return h
end

local function checkSegment(prefix)
	local n = hashString(SALT .. string.lower(prefix)) % 1048576
	local out = ""

	for _ = 1, 4 do
		local index = n % 32
		out = string.sub(ALPHABET, index + 1, index + 1) .. out
		n = math.floor(n / 32)
	end

	return out
end

-- Key format: word-word-word-XXXX-XXXX
local function isValidKey(input)
	local trimmed = string.match(input, "^%s*(.-)%s*$")

	local a, b, c, seg, check = string.match(
		trimmed,
		"^(%a+)%-(%a+)%-(%a+)%-(%w%w%w%w)%-(%w%w%w%w)$"
	)

	if not a then
		return false
	end

	local prefix = a .. "-" .. b .. "-" .. c .. "-" .. seg

	return string.upper(check) == checkSegment(prefix)
end

