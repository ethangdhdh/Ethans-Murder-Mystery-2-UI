local function getOtherPlayers()
	local result = {}

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			table.insert(result, target)
		end
	end

	return result
end

local function refreshPlayerSelection()
	local list = getOtherPlayers()

	if #list == 0 then
		selectedPlayer = nil
		selectedIndex = 0
		selectPlayerButton.Text = "NO OTHER PLAYERS"
		return
	end

	if selectedIndex < 1 or selectedIndex > #list then
		selectedIndex = 1
	end

	selectedPlayer = list[selectedIndex]
	selectPlayerButton.Text = "PLAYER: " .. selectedPlayer.Name
end

selectPlayerButton.Activated:Connect(function()
	local list = getOtherPlayers()

	if #list == 0 then
		selectPlayerButton.Text = "NO OTHER PLAYERS"
		return
	end

	selectedIndex += 1

	if selectedIndex > #list then
		selectedIndex = 1
	end

	refreshPlayerSelection()
end)

Players.PlayerAdded:Connect(function()
	task.wait()
	refreshPlayerSelection()
end)

Players.PlayerRemoving:Connect(function(target)
	if selectedPlayer == target then
		selectedPlayer = nil
	end

	task.wait()
	refreshPlayerSelection()
end)

