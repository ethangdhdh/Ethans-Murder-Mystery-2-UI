-- TP TO SHERIFF GUN (press again to go back)
--==================================================

local gunReturn = nil

local function findGun()
	local drop = workspace:FindFirstChild("GunDrop", true)

	if drop then
		return drop
	end

	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("Tool")
			and item.Parent == workspace
			and string.find(string.lower(item.Name), "gun") then

			return item
		end
	end

	return nil
end

local function getGunCFrame(gun)
	if gun:IsA("BasePart") then
		return gun.CFrame
	end

	if gun:IsA("Model") then
		return gun:GetPivot()
	end

	if gun:IsA("Tool") then
		local handle = gun:FindFirstChild("Handle")

		if handle then
			return handle.CFrame
		end
	end

	return nil
end

local function resetGunButton()
	gunReturn = nil
	gunButton.Text = "TP TO SHERIFF GUN"
end

gunButton.Activated:Connect(function()

	local root = getMyRoot()

	if not root then
		return
	end

	-- Second press: go back to where you started
	if gunReturn then
		root.CFrame = gunReturn
		resetGunButton()
		return
	end

	local gun = findGun()
	local gunCFrame = gun and getGunCFrame(gun)

	if not gunCFrame then
		gunButton.Text = "NO GUN FOUND"

		task.delay(1.5, function()
			if gunButton.Parent and not gunReturn then
				gunButton.Text = "TP TO SHERIFF GUN"
			end
		end)

		return
	end

	gunReturn = root.CFrame
	savedPosition = root.CFrame

	root.CFrame = gunCFrame + Vector3.new(0, 3, 0)

	gunButton.Text = "BACK TO START"

end)

player.CharacterAdded:Connect(resetGunButton)

