local function tryUnlock()
	if keyBox.Text == "" then
		setKeyStatus("Enter your key first.", false)
		return
	end

	if isValidKey(keyBox.Text) then
		setKeyStatus("Key accepted.", true)
		task.wait(0.4)
		keyFrame:Destroy()

		if keyBg then
			keyBg:Destroy()
		end

		window.Visible = true
	else
		setKeyStatus("Invalid key. Check it and try again.", false)
	end
end

